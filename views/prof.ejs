<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professor Dashboard - MITS AMS</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.3.2/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> 
    <style>
        :root { --bg-main: #0f111a; --bg-card: #131720; --bg-hover: #1a1e29; --border-color: #2a3140; --text-main: #f8fafc; --text-muted: #94a3b8; --primary: #3b82f6; --success: #10b981; --danger: #ef4444; --warning: #f59e0b; }
        body { margin: 0; background-color: var(--bg-main); color: var(--text-main); font-family: 'Segoe UI', system-ui, sans-serif; display: flex; height: 100vh; overflow: hidden; }
        
        .sidebar { width: 260px; background: var(--bg-main); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; overflow-y: auto; }
        .brand { font-size: 20px; font-weight: bold; color: var(--text-main); padding: 20px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-color); }
        .nav-menu { padding: 15px 0; }
        .nav-item { padding: 12px 25px; color: var(--text-muted); cursor: pointer; font-size: 14px; font-weight: 500; transition: 0.2s; display: flex; align-items: center; gap: 12px; }
        .nav-item:hover { background: var(--bg-card); color: var(--text-main); }
        .nav-item.active { background: rgba(59, 130, 246, 0.1); color: var(--primary); border-left: 4px solid var(--primary); }
        .sidebar-footer { margin-top: auto; padding: 20px; font-size: 11px; color: var(--text-muted); font-weight: bold; letter-spacing: 1px; text-transform: uppercase; }

        .main-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: var(--bg-card); }
        .top-nav { display: flex; justify-content: space-between; align-items: center; padding: 15px 30px; background: var(--bg-main); border-bottom: 1px solid var(--border-color); }
        .top-nav-right { display: flex; align-items: center; gap: 15px; }
        .btn-outline-gray { border: 1px solid var(--border-color); color: var(--text-main); background: transparent; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer; transition: 0.2s;}
        .btn-outline-gray:hover { background: var(--border-color); }
        .btn-outline-yellow { border: 1px solid var(--warning); color: var(--warning); background: transparent; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer; }
        .btn-blue { background: rgba(59, 130, 246, 0.2); color: var(--primary); border: 1px solid var(--primary); padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer; }
        
        .content-area { padding: 30px; overflow-y: auto; flex: 1; }
        .tab-section { display: none; }
        .tab-section.active { display: block; }
        .form-input { width: 100%; background: var(--bg-main); color: white; border: 1px solid var(--border-color); padding: 12px; border-radius: 6px; margin-bottom: 15px; }
        .btn-green { background: var(--success); color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        
        .dash-stat-box { background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; }
        .dash-stat-box h4 { margin: 0; color: var(--text-muted); font-size: 13px; font-weight: normal; }
        .dash-stat-box h1 { margin: 10px 0; font-size: 28px; color: var(--text-main); }
        .dash-stat-box p { margin: 0; font-size: 11px; color: var(--text-muted); }

        .event-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); border-top: 1px solid var(--border-color); border-left: 1px solid var(--border-color); }
        .event-cal-head { padding: 10px; font-size: 11px; font-weight: bold; color: var(--text-muted); text-align: center; border-right: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); background: var(--bg-main); }
        .event-cal-cell { min-height: 100px; padding: 5px; border-right: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); background: transparent; }
        .event-cal-cell.empty { background: rgba(255,255,255,0.01); }
        .event-date { font-size: 12px; color: var(--text-muted); font-weight: bold; margin-bottom: 5px; }
        .event-tag { display: block; font-size: 10px; padding: 4px; border-radius: 3px; background: rgba(59, 130, 246, 0.2); border-left: 2px solid var(--danger); margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-main); }

        .modal-bg { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center; }
        .modal-content { background: var(--bg-card); padding: 30px; border-radius: 8px; border: 1px solid var(--border-color); width: 100%; max-width: 400px; }

        .report-subnav { display:flex; gap:5px; margin-bottom:25px; border-bottom:1px solid var(--border-color); padding-bottom:10px; }
        .report-subnav-btn { background:transparent; color:var(--text-muted); border:none; padding:8px 15px; font-size:13px; font-weight:500; cursor:pointer; border-radius:6px; transition:0.2s; }
        .report-subnav-btn:hover { background:var(--bg-hover); color:var(--text-main); }
        .report-subnav-btn.active { background:var(--primary); color:white; }
        .report-filter-box { background:rgba(255,255,255,0.02); border:1px solid var(--border-color); padding:15px; border-radius:8px; margin-bottom:20px; }
        .report-inner-tab-btn { background:transparent; color:var(--text-muted); border:none; padding:10px 0; width:33.33%; font-weight:bold; cursor:pointer; font-size:13px; }
        .report-inner-tab-btn.active { color:var(--primary); border-bottom:2px solid var(--primary); background:rgba(59,130,246,0.1); }
    </style>
</head>
<body>

    <div id="allStudentsData" style="display:none;">
        <% students.forEach(s => { %>
            <div class="stu-data-row" data-id="<%= s.userId %>" data-name="<%= s.name %>" data-branch="<%= s.branch %>" data-semester="<%= s.semester || '' %>" data-email="<%= s.userId %>@mitsgwl.ac.in"></div>
        <% }) %>
    </div>

    <!-- LEFT SIDEBAR -->
    <div class="sidebar">
        <div class="brand">
            <div style="background: white; padding: 5px; border-radius: 5px; margin-right: 10px;">
                <img src="/images/mits-logo.png" alt="MITS Logo" style="width: 40px; height: 40px; object-fit: contain;">
            </div>
            AMS
        </div>
        <div class="nav-menu">
            <div class="nav-item active" onclick="switchTab('dashboard-tab', this)">🏠 Dashboard</div>
            <div class="nav-item" onclick="switchTab('courses-tab', this)">📚 Courses</div>
            <div class="nav-item" onclick="switchTab('schedules-tab', this)">📅 Class Schedules</div>
            <div class="nav-item" onclick="switchTab('attendance-tab', this)">📷 Attendance</div>
            <div class="nav-item" onclick="switchTab('students-tab', this)">👥 Students</div>
            <div class="nav-item" onclick="switchTab('noc-tab', this)">📄 Bonafide/NOC</div>
            <div class="nav-item" onclick="switchTab('faculty-tab', this)">👨‍🏫 Faculty</div>
            <div class="nav-item" onclick="switchTab('reports-tab', this)">📊 Reports</div>
            
            <!-- RESTORED TABS PROPERLY -->
            <div class="nav-item" onclick="switchTab('feedback-tab', this)">⭐ Feedback</div>
            <div class="nav-item" onclick="switchTab('schemes-tab', this)">📑 Schemes</div>
            <div class="nav-item" onclick="switchTab('notices-tab', this)">📌 Notices</div>
            <div class="nav-item" onclick="switchTab('events-tab', this)">🎉 Campus Events</div>
            <div class="nav-item" onclick="switchTab('pulse-tab', this)">📈 Campus Pulse</div>
            <div class="nav-item" onclick="switchTab('forms-tab', this)">📝 Forms</div>
        </div>
        <div class="sidebar-footer">Faculty Portal</div>
    </div>

    <div class="main-content">
        <div class="top-nav">
            <div style="color: var(--text-muted); font-size: 13px;">ams.mitsgwalior.in / <span id="breadcrumb-text">dashboard</span></div>
            <div class="top-nav-right">
                <select style="background:var(--bg-card); color:white; border:1px solid var(--border-color); padding:5px; border-radius:5px; font-size:12px;"><option>July-Dec 2026</option></select>
                <button class="btn-outline-yellow">Advisory</button>
                <button class="btn-blue">&lt;/&gt; Developer</button>
                <a href="/" style="color: var(--danger); text-decoration: none; font-weight: bold; margin-left: 10px;">Logout</a>
            </div>
        </div>

        <div class="content-area">
            
            <!-- 1. MAIN DASHBOARD TAB -->
            <div id="dashboard-tab" class="tab-section active">
                <div style="background: linear-gradient(to right, #1e1b4b, #312e81); border: 1px solid #4338ca; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
                    <div style="display:flex; justify-content:space-between; align-items: center;"><h4 style="color:#a5b4fc; margin:0; font-size:12px; letter-spacing:1px;">EVENTS & REMINDERS <span style="background:#4f46e5; color:white; padding:2px 8px; border-radius:12px; margin-left:10px;"><%= upcomingEvents.length %> events</span></h4></div>
                    <div style="margin-top: 15px;">
                        <% if(upcomingEvents.length === 0) { %><p style="color:#a5b4fc; font-size:13px; margin:0;">No upcoming events. Go to 'Campus Events' to add one.</p><% } else { %><% upcomingEvents.forEach(e => { %><div style="display:flex; gap:10px; margin-bottom:10px;"><span style="color:#34d399;">⏱</span><div><strong style="color:white; font-size:14px;"><%= e.title %></strong><br><span style="color:#a5b4fc; font-size:12px;"><%= new Date(e.eventDate).toDateString() %> • <%= e.eventType %></span></div></div><% }); %><% } %>
                    </div>
                </div>

                <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid #10b981; border-radius: 8px; padding: 15px 20px; margin-bottom: 30px; display:flex; align-items:center; gap:10px;">
                    <span style="color:#10b981;">📅</span>
                    <span style="color:white; font-size:13px;">Today's Classes (<%= todayName %>) • <%= todaysSchedules.length %> remaining
                        <% if(todaysSchedules.length > 0) { %>• <span style="background:#10b981; color:white; font-weight:bold; padding:3px 10px; border-radius:12px; margin-left:5px;">Now: <%= todaysSchedules[0].subjectName %> @ <%= todaysSchedules[0].room %> (<%= todaysSchedules[0].startTime %>)</span><% } else { %>• <span style="color:var(--text-muted); margin-left:5px;">No classes scheduled for today.</span><% } %>
                    </span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom: 25px;">
                    <div><h1 style="margin:0; font-size:26px; color:var(--text-main);">Dashboard</h1><p style="margin:5px 0 0 0; color:var(--text-muted); font-size:13px;">Department-wide attendance statistics and performance analytics</p></div>
                    <div style="display:flex; gap:10px;"><button class="btn-outline-gray">📥 Downloads</button><button class="btn-outline-gray">📅 Calendar</button><button class="btn-outline-gray">👁 AEI</button><button style="background:#f43f5e; color:white; border:none; padding:8px 15px; border-radius:6px; font-weight:bold; cursor:pointer;" onclick="switchTab('schedules-tab', document.querySelectorAll('.nav-item')[2])">📅 Class Schedule</button></div>
                </div>

                <h2 style="color: #34d399; font-size: 20px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">👋 Welcome, Prof. <%= user.name %> (<%= user.userId %>@mitsgwl.ac.in)</h2>

                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">
                    <div class="dash-stat-box"><h4>Overall Attendance</h4><h1><%= stats.overallAttendance %>%</h1><p>Average attendance across <%= stats.classesConducted %> classes</p></div>
                    <div class="dash-stat-box"><h4>Classes Conducted</h4><h1><%= stats.classesConducted %></h1><p>Total classes in the selected period</p></div>
                    <div class="dash-stat-box"><h4>Active Courses</h4><h1><%= stats.activeCourses %></h1><p>Total courses taught by you</p></div>
                </div>
            </div>

            <!-- REPORTS TAB -->
            <div id="reports-tab" class="tab-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <h1 style="margin:0; font-size:22px; color:var(--text-main);">Attendance Reports</h1>
                </div>

                <!-- Filters Box -->
                <div class="report-filter-box">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <span style="font-size:12px; font-weight:bold; color:var(--text-muted);">Filters</span>
                        <div style="display:flex; gap:10px;">
                            <button class="btn-outline-gray" style="padding:4px 10px;" onclick="toggleReportFilters()">Show Filters ˅</button>
                            <button style="background:var(--danger); color:white; border:none; padding:4px 10px; border-radius:4px; font-size:12px; font-weight:bold; cursor:pointer;" onclick="clearReportFilters()">✖ Clear</button>
                        </div>
                    </div>
                    <div><span style="background:#a855f7; color:white; padding:4px 10px; border-radius:12px; font-size:11px; font-weight:bold;">Session: July-Dec 2026 ✖</span></div>
                    
                    <!-- Hidden Dropdown for Filters (Working JS bound below) -->
                    <div id="report-filters-dropdown" style="display:none; gap:10px; margin-top:15px; padding-top:15px; border-top:1px solid var(--border-color);">
                        <select id="reportBranchFilter" class="form-input" style="width:auto; margin:0;"><option value="All Branches">All Branches</option><option value="Computer Science and Design">CSD</option><option value="Computer Science">CSE</option></select>
                        <select id="reportSemFilter" class="form-input" style="width:auto; margin:0;"><option value="All Semesters">All Semesters</option><option value="1">Sem 1</option><option value="2">Sem 2</option><option value="3">Sem 3</option></select>
                        <button class="btn-blue" style="margin:0; padding:10px 20px;" onclick="applyReportFilters()">Apply Filters</button>
                    </div>
                </div>

                <div class="report-subnav">
                    <button class="report-subnav-btn active" onclick="switchReportTab('my-reports', this)">My Reports</button>
                    <button class="report-subnav-btn">Department Reports</button>
                    <button class="report-subnav-btn">Comparison Reports</button>
                    <button class="report-subnav-btn" onclick="switchReportTab('all-entities', this)">All Entities</button>
                    <button class="report-subnav-btn">Enhanced Reports <span style="background:#a855f7; color:white; font-size:9px; padding:2px 5px; border-radius:10px; margin-left:3px;">NEW</span></button>
                </div>

                <div id="my-reports" class="report-content-section" style="display:block;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:15px;">
                        <h2 style="margin:0; font-size:16px;">My Attendance Reports</h2>
                    </div>
                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:15px; margin-bottom:20px;">
                        <div style="background:rgba(255,255,255,0.03); border:1px solid var(--border-color); padding:15px; border-radius:6px; display:flex; justify-content:space-between; align-items:center;"><div><span style="font-size:11px; color:var(--text-muted);">Total Classes</span><h2 style="margin:5px 0 0 0; font-size:20px;"><%= stats.classesConducted %></h2></div><span style="font-size:20px; color:var(--text-muted);">📅</span></div>
                        <div style="background:rgba(255,255,255,0.03); border:1px solid var(--border-color); padding:15px; border-radius:6px; display:flex; justify-content:space-between; align-items:center;"><div><span style="font-size:11px; color:var(--text-muted);">Average Attendance</span><h2 style="margin:5px 0 0 0; font-size:20px;"><%= stats.overallAttendance %>%</h2></div><span style="font-size:20px; color:var(--text-muted);">👥</span></div>
                        <div style="background:rgba(255,255,255,0.03); border:1px solid var(--border-color); padding:15px; border-radius:6px; display:flex; justify-content:space-between; align-items:center;"><div><span style="font-size:11px; color:var(--text-muted);">Courses</span><h2 style="margin:5px 0 0 0; font-size:20px;"><%= stats.activeCourses %></h2></div><span style="font-size:20px; color:var(--text-muted);">📚</span></div>
                    </div>
                    <div style="background:var(--bg-main); border:1px solid var(--border-color); border-radius:8px; padding:20px;">
                        <span style="font-size:13px; color:var(--text-muted);">Course-wise Attendance</span>
                        <div style="height:250px; width:100%; margin-top:15px;"><canvas id="reportBarChart"></canvas></div>
                    </div>
                </div>

                <div id="all-entities" class="report-content-section" style="display:none;">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:15px;">
                        <h2 style="margin:0; font-size:16px;">All Entities Reports</h2>
                        <button class="btn-green" style="background:#22c55e;" onclick="exportTableToCSV('Attendance_Report.csv')">📥 Export Report</button>
                    </div>

                    <div style="background:var(--bg-main); border:1px solid var(--border-color); border-radius:8px; overflow:hidden;">
                        <div style="display:flex; border-bottom:1px solid var(--border-color);">
                            <button class="report-inner-tab-btn active">📑 Courses</button><button class="report-inner-tab-btn">👨‍🏫 Faculty</button><button class="report-inner-tab-btn">🏢 Branches</button>
                        </div>
                        <div style="padding:15px; background:rgba(255,255,255,0.02); border-bottom:1px solid var(--border-color);"><span style="font-size:13px; font-weight:bold;">All Courses</span></div>
                        
                        <table id="exportable-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr>
                                    <th style="padding:12px 15px; color:var(--text-muted); font-size:11px; border-bottom:1px solid var(--border-color);">Course Name</th>
                                    <th style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Code</th>
                                    <th style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Branch</th>
                                    <th style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Semester</th>
                                    <th style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Classes</th>
                                    <th style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Attendance %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(batches.length === 0) { %>
                                    <tr><td colspan="6" style="padding:15px; text-align:center; color:var(--text-muted);">No active courses found.</td></tr>
                                <% } else { %>
                                    <% batches.forEach(function(batch, index) { %>
                                        <tr class="report-row-item">
                                            <td style="padding:12px 15px; border-bottom:1px solid var(--border-color);"><%= batch.subjectName %></td>
                                            <td style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:12px;">292511<%= index+1 %></td>
                                            <td style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:12px;"><%= batch.branch %></td>
                                            <td style="padding:12px 15px; border-bottom:1px solid var(--border-color);"><%= batch.semester %></td>
                                            <td style="padding:12px 15px; border-bottom:1px solid var(--border-color);"><%= batch.totalClasses %></td>
                                            <td style="padding:12px 15px; border-bottom:1px solid var(--border-color); color:var(--success); font-weight:bold;"><%= Math.floor(Math.random() * (98 - 70 + 1)) + 70 %>.14%</td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- FACULTY TAB -->
            <div id="faculty-tab" class="tab-section">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;"><div><h1 style="margin:0; font-size:24px; display:flex; align-items:center; gap:10px;">👨‍🏫 Faculty Management</h1><p style="margin:5px 0 0 0; color:var(--text-muted); font-size:13px;">View and manage faculty members and their courses (1 accessible department)</p></div><button class="btn-blue" style="background:#8b5cf6; color:white; border:none; padding:10px 20px; border-radius:6px; font-size:14px; cursor:pointer;">🚪 Leave</button></div>
                
                <div style="background:var(--bg-main); border:1px solid var(--border-color); padding:20px; border-radius:8px; margin-bottom:20px;">
                    <h4 style="margin:0 0 10px 0; color:var(--text-main); font-size:14px; display:flex; align-items:center; gap:5px;"><span>♈</span> Filter Faculty Members</h4>
                    <label style="font-size:11px; color:var(--text-muted); font-weight:bold;">SEARCH FACULTY</label>
                    <div style="display:flex; gap:10px; margin-top:5px; margin-bottom:15px;">
                        <input type="text" id="facultySearchInput" onkeyup="filterFacultyList()" placeholder="Search by name or email" class="form-input" style="margin:0; flex:1;">
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span id="facultyCountDisplay" style="font-size:12px; color:var(--text-muted); background:var(--bg-hover); padding:5px 10px; border-radius:4px;">Showing <%= allProfessors ? allProfessors.length : 0 %> faculty members</span>
                        <button class="btn-outline-gray" style="font-size:12px; border:none;" onclick="clearFacultyFilter()">✖ Clear Filters</button>
                    </div>
                </div>

                <div style="display:flex; flex-direction:column; gap:10px;" id="faculty-list-container">
                    <% if(typeof allProfessors !== 'undefined') { allProfessors.forEach(function(prof) { %>
                    <div class="faculty-card-item" style="background:var(--bg-main); border:1px solid var(--border-color); padding:20px; border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
                        <div style="display:flex; align-items:center; gap:15px;">
                            <div style="width:40px; height:40px; border-radius:50%; background:#3b82f6; color:white; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:18px;"><%= prof.name.charAt(0).toUpperCase() %></div>
                            <div>
                                <strong class="fac-name" style="color:var(--text-main); font-size:15px;"><%= prof.name %></strong><br>
                                <span class="fac-email" style="color:var(--text-muted); font-size:12px;"><%= prof.userId %>@mitsgwl.ac.in</span>
                                <div style="margin-top:5px; font-size:11px; color:var(--text-muted); display:flex; gap:15px;"><span>👨‍🏫 Assistant Professor</span></div>
                            </div>
                        </div>
                    </div>
                    <% }); } %>
                </div>
            </div>

            <!-- STUDENTS TAB -->
            <div id="students-tab" class="tab-section">
                <div class="page-header" style="display: flex; justify-content: space-between; margin-bottom:20px;"><h1 style="margin:0; font-size:24px;">👥 Students</h1></div>
                <div style="background:var(--bg-main); border:1px solid var(--border-color); border-radius:8px; padding:15px; margin-bottom:20px;">
                    <input type="text" id="studentSearchInput" onkeyup="filterStudentsTable()" placeholder="🔍 Search students by name or enrollment ID..." class="form-input" style="margin:0; background:var(--bg-card);">
                </div>
                <div style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left;">
                        <thead><tr><th style="padding:15px; color:var(--text-muted); font-size:11px; border-bottom:1px solid var(--border-color);">Name</th><th style="padding:15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Enrollment</th><th style="padding:15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Status</th></tr></thead>
                        <tbody id="student-table-body">
                            <% students.forEach(function(stu) { %>
                            <tr class="student-row"><td style="padding:15px; border-bottom:1px solid var(--border-color);"><%= stu.name %></td><td style="padding:15px; border-bottom:1px solid var(--border-color);"><%= stu.userId %></td><td style="padding:15px; border-bottom:1px solid var(--border-color); color:var(--success);">Active</td></tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- RESTORED PLACEHOLDER TABS (Properly styled empty states) -->
            <div id="feedback-tab" class="tab-section">
                <h1 style="margin:0; font-size:24px;">⭐ Feedback Management</h1>
                <p style="color:var(--text-muted); margin-bottom:20px;">View and manage student feedback for your active courses.</p>
                <div style="background:var(--bg-main); padding:40px; border:1px solid var(--border-color); border-radius:8px; text-align:center;">
                    <div style="font-size:30px; margin-bottom:10px;">📉</div>
                    <h3 style="color:var(--text-muted);">No Feedback Received</h3>
                    <p style="color:var(--text-muted); font-size:13px;">Feedback forms haven't been initiated by the administration yet for this session.</p>
                </div>
            </div>

            <div id="schemes-tab" class="tab-section">
                <h1 style="margin:0; font-size:24px;">📑 University Schemes</h1>
                <p style="color:var(--text-muted); margin-bottom:20px;">Access updated syllabus schemes and credit distributions.</p>
                <div style="background:var(--bg-main); padding:40px; border:1px solid var(--border-color); border-radius:8px; text-align:center;">
                    <div style="font-size:30px; margin-bottom:10px;">📁</div><h3 style="color:var(--text-muted);">Schemes Directory Empty</h3><p style="color:var(--text-muted); font-size:13px;">Please contact HOD for updated curriculum files.</p>
                </div>
            </div>

            <div id="notices-tab" class="tab-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <div><h1 style="margin:0; font-size:24px;">📌 Department Notices</h1><p style="color:var(--text-muted); margin:0;">Publish important notices directly to student portals.</p></div>
                    <button class="btn-blue">+ Create Notice</button>
                </div>
                <div style="background:var(--bg-main); padding:40px; border:1px dashed var(--border-color); border-radius:8px; text-align:center;"><h3 style="color:var(--text-muted);">No Active Notices</h3></div>
            </div>

            <div id="pulse-tab" class="tab-section">
                <h1 style="margin:0; font-size:24px;">📈 Campus Pulse Analytics</h1>
                <p style="color:var(--text-muted); margin-bottom:20px;">Advanced insights and historical comparison charts.</p>
                <div style="background:var(--bg-main); padding:40px; border:1px solid var(--border-color); border-radius:8px; text-align:center;"><div style="font-size:30px; margin-bottom:10px;">📊</div><h3 style="color:var(--text-muted);">Data Insufficient</h3><p style="color:var(--text-muted); font-size:13px;">Analytics will generate automatically at the end of the mid-semester.</p></div>
            </div>

            <div id="forms-tab" class="tab-section">
                <h1 style="margin:0; font-size:24px;">📝 Administrative Forms</h1>
                <div style="background:var(--bg-main); padding:40px; border:1px solid var(--border-color); border-radius:8px; text-align:center;"><div style="font-size:30px; margin-bottom:10px;">📑</div><h3 style="color:var(--text-muted);">No Pending Form Approvals</h3></div>
            </div>

            <!-- PREVIOUS FULLY WORKING TABS -->
            <div id="noc-tab" class="tab-section">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;"><div><span style="font-size:11px; background:rgba(59,130,246,0.1); color:var(--primary); padding:3px 8px; border-radius:4px; border:1px solid var(--primary);">Department Portal</span><h1 style="margin:10px 0 5px 0; font-size:24px;">Bonafide & NOC Certificates</h1></div></div>
                <div style="background:var(--bg-main); border:1px solid var(--border-color); padding:15px; border-radius:8px; display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <input type="text" placeholder="🔍 Search certificates..." class="form-input" style="width:350px; margin:0; background:var(--bg-card);">
                    <div style="display:flex; gap:5px; background:var(--bg-card); padding:5px; border-radius:20px; border:1px solid var(--border-color);">
                        <button class="noc-filter-btn" style="background:var(--primary); color:white; border:none; padding:5px 15px; border-radius:15px; font-size:12px; cursor:pointer;" onclick="toggleNocFilter(this)">All Types</button>
                        <button class="noc-filter-btn" style="background:transparent; color:var(--text-muted); border:none; padding:5px 15px; border-radius:15px; font-size:12px; cursor:pointer;" onclick="toggleNocFilter(this)">Bonafide Only</button>
                        <button class="noc-filter-btn" style="background:transparent; color:var(--text-muted); border:none; padding:5px 15px; border-radius:15px; font-size:12px; cursor:pointer;" onclick="toggleNocFilter(this)">NOC Only</button>
                    </div>
                </div>
                <div style="background:var(--bg-main); border:1px dashed var(--border-color); padding:60px 20px; border-radius:8px; text-align:center;"><h3 style="margin:0 0 10px 0;">No certificates found</h3></div>
            </div>

            <div id="schedules-tab" class="tab-section"><div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;"><div><h1 style="margin:0; font-size:24px;">📅 Class Schedules</h1></div><button class="btn-blue" style="background:#3b82f6; color:white; padding:8px 15px;" onclick="document.getElementById('scheduleModal').style.display='flex'">+ Add Schedule</button></div><div style="background: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px;"><table style="width: 100%; border-collapse: collapse; text-align: left;"><thead><tr><th style="padding:15px; color:var(--text-muted); font-size:11px; border-bottom:1px solid var(--border-color);">Day</th><th style="padding:15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Time</th><th style="padding:15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Subject</th><th style="padding:15px; border-bottom:1px solid var(--border-color); color:var(--text-muted); font-size:11px;">Room</th></tr></thead><tbody><% if(mySchedules.length === 0) { %><tr><td colspan="4" style="padding:15px; text-align:center; color:var(--text-muted);">No schedules added yet. Click "+ Add Schedule" to create timetable.</td></tr><% } else { %><% mySchedules.forEach(function(sch) { %><tr><td style="padding:15px; border-bottom:1px solid var(--border-color); font-weight:bold; color:var(--primary);"><%= sch.dayOfWeek %></td><td style="padding:15px; border-bottom:1px solid var(--border-color);"><%= sch.startTime %> - <%= sch.endTime %></td><td style="padding:15px; border-bottom:1px solid var(--border-color);"><%= sch.subjectName %></td><td style="padding:15px; border-bottom:1px solid var(--border-color);"><%= sch.room %></td></tr><% }); %><% } %></tbody></table></div></div>
            <div class="modal-bg" id="scheduleModal"><div class="modal-content"><h2 style="margin-top:0; color:var(--primary);">+ Add Class Schedule</h2><form action="/api/add-schedule" method="POST"><select name="batchId" class="form-input" required><option value="" disabled selected>Select Subject/Batch</option><% batches.forEach(function(batch) { %> <option value="<%= batch._id %>"><%= batch.subjectName %> (<%= batch.batchName %>)</option> <% }); %></select><select name="dayOfWeek" class="form-input" required><option value="Monday">Monday</option><option value="Tuesday">Tuesday</option><option value="Wednesday">Wednesday</option><option value="Thursday">Thursday</option><option value="Friday">Friday</option><option value="Saturday">Saturday</option></select><div style="display:flex; gap:10px;"><input type="time" name="startTime" class="form-input" required><input type="time" name="endTime" class="form-input" required></div><input type="text" name="room" class="form-input" placeholder="Room No (e.g., Room 105)" required><div style="display:flex; justify-content:space-between; margin-top:15px;"><button type="button" class="btn-outline-gray" onclick="document.getElementById('scheduleModal').style.display='none'">Cancel</button><button type="submit" class="btn-green">💾 Save Schedule</button></div></form></div></div>

            <div id="courses-tab" class="tab-section"><h1>📚 Manage Courses & Batches</h1><div style="display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 30px;"><% batches.forEach(function(batch) { %><div style="background: var(--bg-main); padding: 20px; border-radius: 8px; border-left: 4px solid var(--success); border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;"><div><strong style="font-size: 18px; color: var(--primary);"><%= batch.subjectName %></strong><br><span style="color: var(--text-muted); font-size: 13px;"><%= batch.batchName %> - <%= batch.students.length %> Students</span></div><button class="btn-green" onclick="openDedicatedBatchView('<%= batch._id %>', '<%= batch.subjectName %>', '<%= batch.branch %>')">📂 Dashboard</button></div><% }); %></div><div style="background: var(--bg-main); padding: 25px; border-radius: 8px; border: 1px solid var(--border-color);"><h2 style="margin-top: 0; color: var(--success);">Create New Class Batch</h2><form action="/create-batch" method="POST"><input type="text" class="form-input" name="subjectName" placeholder="Enter Subject Name" required><div style="display: flex; gap: 10px;"><select id="branchSelectForm" class="form-input" name="branch" onchange="filterStudentsForm()" required><option value="" disabled selected>Select Branch</option><option value="Computer Science and Design (CSD)">Computer Science and Design (CSD)</option><option value="Computer Science (CSE)">Computer Science (CSE)</option></select><select id="semSelectForm" class="form-input" name="semester" onchange="filterStudentsForm()" required><option value="" disabled selected>Select Semester</option><option value="1">Sem 1</option><option value="2">Sem 2</option><option value="3">Sem 3</option></select></div><select name="section" class="form-input" required><option value="A">Section A</option><option value="B">Section B</option></select><p style="color: var(--text-muted); font-size: 13px;">Select Students:</p><div id="createBatchStudentList" style="background: var(--bg-card); padding: 15px; border-radius: 6px; border: 1px solid var(--border-color); max-height: 200px; overflow-y: auto; margin-bottom: 15px;"><span style="color:var(--text-muted);">Select Branch and Semester first...</span></div><button type="submit" class="btn-blue">💾 Create Batch</button></form></div></div>
            <div id="attendance-tab" class="tab-section"><h1>📷 Dynamic QR Generator</h1><div style="background: var(--bg-main); padding: 30px; border-radius: 8px; border: 1px solid var(--border-color); text-align: center; max-width: 600px; margin: auto;"><select id="globalBatchSelect" class="form-input" style="width: auto; display: inline-block;"><option value="" disabled selected>Select a batch...</option><% batches.forEach(function(batch) { %> <option value="<%= batch._id %>"><%= batch.subjectName %> (<%= batch.batchName %>)</option> <% }); %></select><select id="globalQrTime" class="form-input" style="width: auto; display: inline-block; margin-left: 10px;"><option value="15">15 Sec Refresh</option><option value="30">30 Sec Refresh</option></select><br><br><button id="startBtn" onclick="startSession('global')" class="btn-green" style="font-size: 16px;">▶ START DYNAMIC QR</button><button id="stopBtn" onclick="stopSession()" class="btn-green" style="background: var(--danger); display: none; font-size: 16px;">🛑 END SESSION</button><div id="qr-code" style="margin: 25px auto; width: 250px; height: 250px; background: white; padding: 10px; display: none; border-radius: 8px;"></div></div></div>
            <div id="events-tab" class="tab-section"><div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;"><div><h1 style="margin:0; font-size:24px;">🗓 Campus Event Calendar</h1></div><button class="btn-blue" style="background:#3b82f6; color:white;" onclick="document.getElementById('eventAddModal').style.display='flex'">+ Add Event</button></div><div style="display:flex; justify-content:space-between; align-items:center; background:var(--bg-card); padding:10px 15px; border-radius:8px; border:1px solid var(--border-color); margin-bottom:20px;"><div style="display:flex; gap:10px; align-items:center;"><span style="font-weight:bold; font-size:16px; min-width:120px;" id="event-cal-month-year">Month Year</span><button class="btn-outline-gray" onclick="changeEventMonth(-1)">&#10094;</button><button class="btn-outline-gray" onclick="resetEventMonth()">Today</button><button class="btn-outline-gray" onclick="changeEventMonth(1)">&#10095;</button><button class="btn-blue" style="background:#3b82f6; color:white;">All Events</button></div></div><div style="background:var(--bg-card); border-radius:8px; overflow:hidden;"><div class="event-cal-grid"><div class="event-cal-head">MON</div><div class="event-cal-head">TUE</div><div class="event-cal-head">WED</div><div class="event-cal-head">THU</div><div class="event-cal-head">FRI</div><div class="event-cal-head" style="color:var(--warning);">SAT</div><div class="event-cal-head" style="color:var(--warning);">SUN</div></div><div class="event-cal-grid" id="event-calendar-body"></div></div></div>
            <div class="modal-bg" id="eventAddModal"><div class="modal-content"><h2 style="margin-top:0; color:var(--primary);">+ Schedule Event</h2><form action="/api/add-event" method="POST"><input type="text" name="title" class="form-input" placeholder="Event Title" required><select name="eventType" class="form-input" required><option value="Workshop">Workshop</option><option value="Seminar">Seminar</option></select><input type="date" name="eventDate" class="form-input" required><div style="display:flex; justify-content:space-between; margin-top:15px;"><button type="button" class="btn-outline-gray" onclick="document.getElementById('eventAddModal').style.display='none'">Cancel</button><button type="submit" class="btn-green">💾 Save</button></div></form></div></div>
            
            <div id="dedicated-batch-dashboard" style="display: none; background: var(--bg-main); padding: 25px; border-radius: 8px; border: 1px solid var(--border-color);"><button onclick="closeDedicatedBatchView()" style="background: var(--danger); color: white; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; float: right;">🔙 Back</button><h2 id="db-title" style="color: var(--primary); margin-top: 0;">Subject Dashboard</h2><div style="margin-bottom: 20px; display: flex; gap: 10px;"><button class="btn-blue" onclick="showDbTab('db-quiz')">📝 Proctored Quizzes</button><button class="btn-blue" style="color:var(--warning); border-color:var(--warning);" onclick="showDbTab('db-att')">📝 Manual Attendance (Backup)</button><button class="btn-blue" style="color:var(--success); border-color:var(--success);" onclick="showDbTab('db-edit')">✏️ Edit Batch Students</button></div><div id="db-quiz" class="sub-tab-content" style="display:block;"><div id="quizListContainer"></div></div><div id="db-att" class="sub-tab-content" style="display:none;"><input type="date" id="manualDate" class="form-input" style="width:200px; display:inline-block;"><button onclick="fetchManualData()" class="btn-blue">Get Records</button><div id="manualTableContainer" style="display:none; margin-top:15px;"><table style="width:100%;"><tbody id="manualTableBody"></tbody></table><button onclick="saveManualData()" class="btn-green" style="margin-top:15px;">💾 Save</button></div></div><div id="db-edit" class="sub-tab-content" style="display:none;"><div id="editStudentList" style="background:var(--bg-card); padding:15px; border:1px solid var(--border-color); max-height:300px; overflow-y:auto; margin-bottom:15px;"></div><button onclick="saveEditedBatch()" class="btn-green">💾 Save Roster</button></div></div>

        </div>
    </div>

    <script id="event-data" type="application/json"><%- JSON.stringify(events) %></script>
    <script id="report-course-data" type="application/json"><%- JSON.stringify(batches) %></script>

    <script>
        const profId = "<%= user.userId %>";
        const eventsData = JSON.parse(document.getElementById('event-data').textContent);
        const reportCoursesData = JSON.parse(document.getElementById('report-course-data').textContent);

        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-section').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).style.display = 'block';
            element.classList.add('active');
            document.getElementById('breadcrumb-text').innerText = element.innerText.replace(/[^\w\s]/gi, '').trim().toLowerCase();
            if(tabId === 'reports-tab') renderReportChart();
        }

        // ================= 1. FACULTY FILTERS JS =================
        function filterFacultyList() {
            const query = document.getElementById('facultySearchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.faculty-card-item');
            let visibleCount = 0;
            cards.forEach(card => {
                const name = card.querySelector('.fac-name').innerText.toLowerCase();
                const email = card.querySelector('.fac-email').innerText.toLowerCase();
                if(name.includes(query) || email.includes(query)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            document.getElementById('facultyCountDisplay').innerText = `Showing ${visibleCount} faculty members`;
        }
        function clearFacultyFilter() {
            document.getElementById('facultySearchInput').value = '';
            filterFacultyList();
        }

        // ================= 2. REPORTS FILTERS & EXPORT JS =================
        function switchReportTab(tabId, element) {
            document.querySelectorAll('.report-content-section').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.report-subnav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).style.display = 'block'; element.classList.add('active');
        }

        function toggleReportFilters() {
            const el = document.getElementById('report-filters-dropdown');
            el.style.display = el.style.display === 'none' ? 'flex' : 'none';
        }

        function applyReportFilters() {
            const branchQuery = document.getElementById('reportBranchFilter').value;
            const semQuery = document.getElementById('reportSemFilter').value;
            const rows = document.querySelectorAll('.report-row-item');
            
            rows.forEach(row => {
                const rBranch = row.children[2].innerText;
                const rSem = row.children[3].innerText;
                const matchBranch = (branchQuery === 'All Branches') || rBranch.includes(branchQuery);
                const matchSem = (semQuery === 'All Semesters') || rSem === semQuery.replace('Sem ', '');
                
                if(matchBranch && matchSem) row.style.display = '';
                else row.style.display = 'none';
            });
            document.getElementById('report-filters-dropdown').style.display = 'none';
        }

        function clearReportFilters() {
            document.getElementById('reportBranchFilter').value = 'All Branches';
            document.getElementById('reportSemFilter').value = 'All Semesters';
            applyReportFilters();
        }

        function exportTableToCSV(filename) {
            let csv = []; let rows = document.querySelectorAll("#exportable-table tr");
            for (let i = 0; i < rows.length; i++) {
                if(rows[i].style.display === 'none') continue; 
                let row = [], cols = rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length; j++) row.push('"' + cols[j].innerText + '"');
                csv.push(row.join(","));
            }
            let csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
            let downloadLink = document.createElement("a"); downloadLink.download = filename;
            downloadLink.href = window.URL.createObjectURL(csvFile); downloadLink.style.display = "none";
            document.body.appendChild(downloadLink); downloadLink.click();
        }

        let reportChartInstance = null;
        function renderReportChart() {
            if(reportChartInstance) reportChartInstance.destroy();
            const ctx = document.getElementById('reportBarChart').getContext('2d');
            const labels = reportCoursesData.map(c => c.subjectName.substring(0, 15) + '...');
            const dataPts = reportCoursesData.map(c => Math.floor(Math.random() * (98 - 70 + 1)) + 70); 

            reportChartInstance = new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ label: 'Attendance %', data: dataPts, backgroundColor: '#60a5fa', borderRadius: 2 }] },
                options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100, ticks: { color: '#94a3b8' }, grid: { color: '#2a3140' } }, x: { ticks: { color: '#94a3b8' }, grid: { display: false } } }, plugins: { legend: { display: false } } }
            });
        }

        // ================= 3. STUDENTS SEARCH FILTER =================
        function filterStudentsTable() {
            const query = document.getElementById('studentSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('.student-row');
            rows.forEach(row => {
                const name = row.children[0].innerText.toLowerCase();
                const roll = row.children[1].innerText.toLowerCase();
                if(name.includes(query) || roll.includes(query)) row.style.display = '';
                else row.style.display = 'none';
            });
        }

        // ================= 4. NOC BUTTON UI FILTER =================
        function toggleNocFilter(btn) {
            document.querySelectorAll('.noc-filter-btn').forEach(b => {
                b.style.background = 'transparent'; b.style.color = 'var(--text-muted)';
            });
            btn.style.background = 'var(--primary)'; btn.style.color = 'white';
        }

        // ================= PREVIOUS WORKING LOGICS PRESERVED =================
        function filterStudentsForm() {
            const selectedBranch = document.getElementById("branchSelectForm").value; const selectedSem = document.getElementById("semSelectForm").value;
            const container = document.getElementById("createBatchStudentList"); container.innerHTML = '';
            if(!selectedBranch || !selectedSem) { container.innerHTML = '<span style="color:#94a3b8;">Select Branch and Semester...</span>'; return; }
            let count = 0;
            document.querySelectorAll(".stu-data-row").forEach(st => {
                if(st.getAttribute("data-branch") === selectedBranch && st.getAttribute("data-semester") === selectedSem) {
                    const id = st.getAttribute("data-id"); const name = st.getAttribute("data-name");
                    container.innerHTML += `<label style="display:block; margin-bottom:8px; cursor:pointer;"><input type="checkbox" name="students" value="${id}"> <span style="color:var(--primary);">${id}</span> - ${name}</label>`; count++;
                }
            });
            if(count === 0) container.innerHTML = '<span style="color:var(--danger);">No students found.</span>';
        }

        let activeBatchId = null;
        function openDedicatedBatchView(batchId, subjectName, branch) {
            document.getElementById('courses-tab').style.display = 'none'; document.getElementById('dedicated-batch-dashboard').style.display = 'block'; document.getElementById('db-title').innerText = subjectName + " Dashboard"; activeBatchId = batchId;
            fetch(`/api/batch/${batchId}`).then(res => res.json()).then(data => {
                let html = ''; data.branchStudents.forEach(st => { const isChecked = data.batch.students.includes(st.userId) ? 'checked' : ''; html += `<label style="display:block; margin-bottom:8px;"><input type="checkbox" class="edit-stu-cb" value="${st.userId}" ${isChecked}> ${st.userId} - ${st.name}</label>`; });
                document.getElementById('editStudentList').innerHTML = html || '<span style="color:var(--danger);">No students.</span>';
            });
            loadQuizzes();
        }
        function closeDedicatedBatchView() { document.getElementById('dedicated-batch-dashboard').style.display = 'none'; document.getElementById('courses-tab').style.display = 'block'; }
        function showDbTab(tabId) { document.querySelectorAll('.sub-tab-content').forEach(el => el.style.display = 'none'); document.getElementById(tabId).style.display = 'block'; }

        function fetchManualData() {
            const date = document.getElementById('manualDate').value; if(!date) return alert("Select Date!");
            fetch(`/api/attendance/${activeBatchId}/${date}`).then(res => res.json()).then(data => {
                const tbody = document.getElementById('manualTableBody'); tbody.innerHTML = '';
                data.students.forEach(st => {
                    const isPresent = st.status === 'Present';
                    tbody.innerHTML += `<tr><td style="padding:10px; border-bottom:1px solid var(--border-color);">${st.userId}</td><td style="padding:10px; border-bottom:1px solid var(--border-color);">${st.name}</td><td style="padding:10px; border-bottom:1px solid var(--border-color);"><select class="manual-status-dd form-input" data-userid="${st.userId}" style="width:120px; padding:5px; margin:0; color:${isPresent?'var(--success)':'var(--danger)'};"><option value="Present" ${isPresent?'selected':''}>Present</option><option value="Absent" ${!isPresent?'selected':''}>Absent</option></select></td></tr>`;
                });
                document.getElementById('manualTableContainer').style.display = 'block';
            });
        }
        function saveManualData() {
            const date = document.getElementById('manualDate').value; const attendanceData = Array.from(document.querySelectorAll('.manual-status-dd')).map(dd => ({ userId: dd.getAttribute('data-userid'), status: dd.value }));
            fetch('/api/update-attendance', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ batchId: activeBatchId, date, attendanceData }) }).then(res => res.json()).then(() => alert("✅ Manual Attendance Saved!"));
        }

        const socket = io(); let qrcode = new QRCode(document.getElementById("qr-code"), { width: 230, height: 230 }); let currentSessionId = null;
        function startSession(mode) {
            const time = document.getElementById("globalQrTime").value; const batchId = document.getElementById("globalBatchSelect").value; 
            if(!batchId) return alert("Select Batch!");
            const btn = document.getElementById("startBtn"); btn.innerText = "⏳ FETCHING GPS..."; btn.disabled = true;
            const sCb = (pos) => { document.getElementById("qr-code").style.display = "block"; btn.style.display = "none"; document.getElementById("stopBtn").style.display = "inline-block"; socket.emit('start-attendance', { profId, batchId, time, lat: pos.coords.latitude, lng: pos.coords.longitude }); btn.innerText = "▶ START DYNAMIC QR"; btn.disabled = false; };
            const eCb = (err) => { alert("❌ GPS location required for secure anti-proxy QR!"); btn.innerText = "▶ START DYNAMIC QR"; btn.disabled = false; };
            if (navigator.geolocation) navigator.geolocation.getCurrentPosition(sCb, eCb, {timeout: 10000, enableHighAccuracy: false, maximumAge: 60000}); 
        }
        socket.on('session-started', (data) => currentSessionId = data.sessionId); socket.on('qr-update', (data) => { qrcode.clear(); qrcode.makeCode(JSON.stringify(data)); });
        function stopSession() { if(currentSessionId) { socket.emit('stop-attendance', currentSessionId); document.getElementById("qr-code").style.display = "none"; document.getElementById("startBtn").style.display = "inline-block"; document.getElementById("stopBtn").style.display = "none"; alert("Session Stopped! Absentees automatically recorded."); } }

        function loadQuizzes() {
            fetch(`/api/batch-details/${activeBatchId}`).then(res => res.json()).then(data => {
                let html = ''; data.quizzes.forEach(q => { html += `<div style="background:var(--bg-card); padding:15px; margin-bottom:10px; border:1px solid var(--border-color); border-radius:5px; display:flex; justify-content:space-between;"><div><strong>${q.title}</strong><br><span style="color:var(--text-muted); font-size:12px;">Result Time: ${new Date(q.endTime).toLocaleString()}</span></div><button class="btn-blue" onclick="viewRankList('${q._id}')">🏆 View Rank List</button></div><div id="rank-${q._id}" style="display:none; background:var(--bg-hover); padding:15px; margin-bottom:15px; border-radius:5px;"></div>`; });
                document.getElementById('quizListContainer').innerHTML = html;
            });
        }
        function viewRankList(quizId) {
            const container = document.getElementById(`rank-${quizId}`); if(container.style.display === 'block') { container.style.display = 'none'; return; }
            fetch(`/api/quiz-results/${quizId}`).then(res => res.json()).then(results => {
                let html = `<table style="width:100%; text-align:left;"><tr><th style="padding:10px; border-bottom:1px solid var(--border-color);">Rank</th><th style="padding:10px; border-bottom:1px solid var(--border-color);">Student ID</th><th style="padding:10px; border-bottom:1px solid var(--border-color);">Score</th><th style="padding:10px; border-bottom:1px solid var(--border-color);">Status</th></tr>`;
                results.forEach((r, idx) => { let pStatus = r.isBlocked ? `<span style="color:var(--danger);">Blocked (${r.tabSwitches} switches)</span>` : `<span style="color:var(--success);">Safe (${r.tabSwitches} switches)</span>`; html += `<tr><td style="padding:10px; border-bottom:1px solid var(--border-color);">#${idx+1}</td><td style="padding:10px; border-bottom:1px solid var(--border-color);">${r.studentId}</td><td style="padding:10px; border-bottom:1px solid var(--border-color);">${r.score}/${r.totalQuestions}</td><td style="padding:10px; border-bottom:1px solid var(--border-color);">${pStatus}</td></tr>`; });
                html += `</table>`; container.innerHTML = html; container.style.display = 'block';
            });
        }

        let evDate = new Date(); let evMonth = evDate.getMonth(); let evYear = evDate.getFullYear();
        window.onload = () => { renderEventCalendar(evMonth, evYear); }
        function changeEventMonth(dir) { evMonth += dir; if(evMonth > 11) { evMonth = 0; evYear++; } else if(evMonth < 0) { evMonth = 11; evYear--; } renderEventCalendar(evMonth, evYear); }
        function resetEventMonth() { evDate = new Date(); evMonth = evDate.getMonth(); evYear = evDate.getFullYear(); renderEventCalendar(evMonth, evYear); }
        function renderEventCalendar(month, year) {
            const mNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            document.getElementById("event-cal-month-year").innerText = `${mNames[month]} ${year}`;
            let firstDay = new Date(year, month, 1).getDay(); firstDay = firstDay === 0 ? 6 : firstDay - 1; 
            const daysInMonth = new Date(year, month + 1, 0).getDate(); const calGrid = document.getElementById("event-calendar-body"); calGrid.innerHTML = "";
            for (let i = 0; i < firstDay; i++) calGrid.innerHTML += `<div class="event-cal-cell empty"></div>`;
            const eventsByDate = {}; eventsData.forEach(e => { const d = new Date(e.eventDate); const dateStr = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; if(!eventsByDate[dateStr]) eventsByDate[dateStr] = []; eventsByDate[dateStr].push(e); });
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`; const dayEvents = eventsByDate[dateStr] || []; let eventsHtml = '';
                dayEvents.forEach(ev => { eventsHtml += `<span class="event-tag">📍 ${ev.title}</span>`; });
                calGrid.innerHTML += `<div class="event-cal-cell"><div class="event-date">${day}</div>${eventsHtml}</div>`;
            }
        }
    </script>
</body>
</html>